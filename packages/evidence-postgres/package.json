    "test": "vitest run --root ../.. packages/evidence-postgres"
  },
  "dependencies": {
    "@bte/core": "workspace:*",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
