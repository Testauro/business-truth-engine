  "description": "Business Truth Engine evidence store on PostgreSQL: append-only, idempotent ingest, filtered and as-of loading into the core EvidenceSet.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
