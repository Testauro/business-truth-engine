# Business Truth Engine - example environment file. Copy to .env and adjust.
# No secrets are required anywhere in this repository.

# ---- Demo shop (apps/demo) ----
# Clock: system (wall clock) or manual (controllable via POST /admin/clock/advance; used by tests)
BTE_DEMO_CLOCK=system
# Start instant for the manual clock (ISO-8601); defaults to boot time
BTE_DEMO_CLOCK_START=

# ---- Playwright suite (tests/e2e) ----
# Attach to an external demo instead of starting one per worker (run with --workers=1)
BTE_E2E_BASE_URL=
# Include the fail-by-design @demonstration spec in a normal run
BTE_E2E_INCLUDE_DEMONSTRATION=

BTE_DEMO_PORT=3000
BTE_DEMO_HOST=127.0.0.1
# Comma-separated seeded business faults. Any of:
#   missing-invoice, duplicate-invoice, wrong-amount, invoicing-unavailable, delayed-invoice, duplicate-delivery
# They can also be toggled at runtime on /admin/faults.
BTE_DEMO_FAULTS=
# Fastify request logging (true/false)
BTE_DEMO_LOG=false
# How often delayed invoices are materialised, in milliseconds
BTE_DEMO_TICK_MS=1000
