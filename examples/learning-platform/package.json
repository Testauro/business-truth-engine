{
  "name": "learning-platform-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Independent consumer of the Business Truth Engine: an online learning platform stub with its own Playwright tests. BTE is installed from packed tarballs, never from workspace sources.",
  "type": "module",
  "scripts": {
    "start": "node app/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "playwright test",
    "bte:validate": "bte rules validate",
    "bte:verify": "bte verify --now 2026-05-01T09:02:00Z"
  },
  "dependencies": {
    "@bte/cli": "file:../../dist-packages/bte-cli-0.1.0.tgz",
    "@bte/core": "file:../../dist-packages/bte-core-0.1.0.tgz",
    "@bte/evidence": "file:../../dist-packages/bte-evidence-0.1.0.tgz",
    "@bte/evidence-http": "file:../../dist-packages/bte-evidence-http-0.1.0.tgz",
    "@bte/evidence-postgres": "file:../../dist-packages/bte-evidence-postgres-0.1.0.tgz",
    "@bte/playwright": "file:../../dist-packages/bte-playwright-0.1.0.tgz",
    "@bte/rules": "file:../../dist-packages/bte-rules-0.1.0.tgz",
    "@bte/sdk": "file:../../dist-packages/bte-sdk-0.1.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "typescript": "~5.9.3"
  }
}
