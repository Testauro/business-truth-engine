# OrangeHRM consumer configuration. Copy to .env (git-ignored) or set in CI. Never commit values.

# ---- Public demo (read-only) ----
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
# The demo's published login; set them here, never in code.
ORANGEHRM_USERNAME=
ORANGEHRM_PASSWORD=

# ---- Independent API evidence (choose one) ----
# token: OrangeHRM Starter API v2 OAuth2 bearer token (https://api-starter-orangehrm.readme.io/)
# session: reuse the Playwright login session cookie (written to ORANGEHRM_SESSION_FILE by the setup project)
# none: no authorized API access; every API-backed verification is UNKNOWN
ORANGEHRM_API_MODE=session
ORANGEHRM_API_TOKEN=
ORANGEHRM_SESSION_FILE=.auth/session.json

# ---- Private instance (state-changing leave workflow; NEVER the public demo) ----
ORANGEHRM_PRIVATE_BASE_URL=
ORANGEHRM_PRIVATE_USERNAME=
ORANGEHRM_PRIVATE_PASSWORD=
# Employee used for leave tests (must exist with an entitlement for ORANGEHRM_PRIVATE_LEAVE_TYPE)
ORANGEHRM_PRIVATE_EMP_NUMBER=
ORANGEHRM_PRIVATE_LEAVE_TYPE=
